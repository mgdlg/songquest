# ---------------------------------------------------------------------------
# Song Quest — environment
#
# Nothing here is needed to PLAY the game. The bird data is pre-generated and
# committed under public/data/, and the site never calls an API that needs a key.
#
# This file matters only if you regenerate that data with
#   npx tsx scripts/generate-dossiers.ts
# Copy it to `.env.local` (git-ignored) and fill in the key below.
# ---------------------------------------------------------------------------

# Required for regenerating bird data. There is no keyless fallback: Xeno-canto
# retired its unauthenticated v2 API (404 for every query) and v3 answers 401
# without a key.
#
# A key is free — register at https://xeno-canto.org/ and copy it from your
# account page. Keep it in `.env.local` only. It must never be committed, and
# never given a NEXT_PUBLIC_ prefix: this is a static site, and anything shipped
# to the browser can be read by anyone.
XENO_CANTO_API_KEY=
