# ---------------------------------------------------------------------------
# Song Quest — environment
#
# Copy to `.env.local` (git-ignored) and fill in the key below. No key is
# required for iNaturalist, GBIF or CARTO — only for Xeno-canto.
# ---------------------------------------------------------------------------

# REQUIRED. Without it no audio can be fetched and no round will start.
#
# There is no keyless fallback: Xeno-canto retired its unauthenticated v2 API
# (it now returns 404 for every query) and the current v3 API answers 401
# without a key. Both verified against the live service.
#
# A key is free — register at https://xeno-canto.org/ and copy it from your
# account page. Server-side only: never prefix this with NEXT_PUBLIC_, or the
# key ships to the browser.
XENO_CANTO_API_KEY=
